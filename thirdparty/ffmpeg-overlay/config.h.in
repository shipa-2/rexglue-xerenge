/* The platform config, and on macOS the components this build compiles set to
 * match it. The source lists in thirdparty/CMakeLists.txt build libavformat for
 * ASF and MP3 (the containers XMP songs come in) and libavcodec for the WMA and
 * MP3 decoders, which is what the x86-64 Linux and Windows configs and both
 * Android configs say. The macOS configs were generated for another selection:
 * network and the WAV demuxer on, ASF, MP3 and WMA off. libavformat then failed
 * to link on a Mac (ff_network_init, ff_tls_init, ff_wav_demuxer) and would
 * have had no demuxer for the songs. Every other platform gets the vendored
 * config untouched. */
#include "@FFMPEG_DIR@/config.h"

#if defined(__APPLE__)

#undef CONFIG_NETWORK
#define CONFIG_NETWORK 0
#undef CONFIG_WAV_DEMUXER
#define CONFIG_WAV_DEMUXER 0

#undef CONFIG_ASF_DEMUXER
#define CONFIG_ASF_DEMUXER 1
#undef CONFIG_MP3_DEMUXER
#define CONFIG_MP3_DEMUXER 1
#undef CONFIG_WMAV2_DECODER
#define CONFIG_WMAV2_DECODER 1
#undef CONFIG_MP3_DECODER
#define CONFIG_MP3_DECODER 1
#undef CONFIG_MP3FLOAT_DECODER
#define CONFIG_MP3FLOAT_DECODER 1

#undef CONFIG_PARSERS
#define CONFIG_PARSERS 1
#undef CONFIG_MPEGAUDIO_PARSER
#define CONFIG_MPEGAUDIO_PARSER 1
#undef CONFIG_MPEGAUDIO
#define CONFIG_MPEGAUDIO 1
#undef CONFIG_MPEGAUDIODSP
#define CONFIG_MPEGAUDIODSP 1
#undef CONFIG_MPEGAUDIOHEADER
#define CONFIG_MPEGAUDIOHEADER 1
#undef CONFIG_DCT
#define CONFIG_DCT 1
#undef CONFIG_RDFT
#define CONFIG_RDFT 1

#endif

/* WMV3 (VC-1 Main) video, every platform: the title's movies are WMV3 in ASF,
 * and decoding them on the host is far cheaper than running the title's own
 * recompiled decoder (rexglue's movie hook). These are the components
 * configure selects for wmv3_decoder; the sources are listed in
 * thirdparty/CMakeLists.txt. */
#undef CONFIG_VC1_DECODER
#define CONFIG_VC1_DECODER 1
#undef CONFIG_WMV3_DECODER
#define CONFIG_WMV3_DECODER 1
#undef CONFIG_H263_DECODER
#define CONFIG_H263_DECODER 1
#undef CONFIG_VC1DSP
#define CONFIG_VC1DSP 1
#undef CONFIG_H264QPEL
#define CONFIG_H264QPEL 1
#undef CONFIG_H264CHROMA
#define CONFIG_H264CHROMA 1
#undef CONFIG_INTRAX8
#define CONFIG_INTRAX8 1
#undef CONFIG_MPEGVIDEO
#define CONFIG_MPEGVIDEO 1
#undef CONFIG_BLOCKDSP
#define CONFIG_BLOCKDSP 1
#undef CONFIG_HPELDSP
#define CONFIG_HPELDSP 1
#undef CONFIG_IDCTDSP
#define CONFIG_IDCTDSP 1
#undef CONFIG_FDCTDSP
#define CONFIG_FDCTDSP 1
#undef CONFIG_PIXBLOCKDSP
#define CONFIG_PIXBLOCKDSP 1
#undef CONFIG_ME_CMP
#define CONFIG_ME_CMP 1
#undef CONFIG_MPEG_ER
#define CONFIG_MPEG_ER 1
#undef CONFIG_ERROR_RESILIENCE
#define CONFIG_ERROR_RESILIENCE 1
#undef CONFIG_VIDEODSP
#define CONFIG_VIDEODSP 1
#undef CONFIG_H263DSP
#define CONFIG_H263DSP 1
#undef CONFIG_QPELDSP
#define CONFIG_QPELDSP 1
#undef CONFIG_WMV2DSP
#define CONFIG_WMV2DSP 1
#undef CONFIG_STARTCODE
#define CONFIG_STARTCODE 1
